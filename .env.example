# PostgreSQL - reemplazar únicamente en el archivo local .env
DB_USER=new_records_app
DB_PASSWORD=change_this_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=new_records_db

# Flask
SECRET_KEY=change_this_with_a_long_random_value
FLASK_DEBUG=1

# Correo para PIN y notificaciones
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=change_this_mail_password
MAIL_DEFAULT_SENDER=ventas@newrecords.example

# Cuentas iniciales de desarrollo
ADMIN_NAME=Administrador New Records
ADMIN_EMAIL=admin@newrecords.local
ADMIN_PASSWORD=change_admin_password
CLIENTE_DEMO_NAME=Cliente Demo
CLIENTE_DEMO_EMAIL=cliente@newrecords.local
CLIENTE_DEMO_PASSWORD=change_client_password
