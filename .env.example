# PostgreSQL - reemplazar únicamente en el archivo local .env
DB_USER=new_records_app
DB_PASSWORD=change_this_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=new_records_db

# Roles PostgreSQL. El usuario bootstrap se usa solamente al configurarlos.
DB_ADMIN_USER=new_records_admin
DB_ADMIN_PASSWORD=change_admin_db_password
DB_BACKUP_USER=new_records_backup
DB_BACKUP_PASSWORD=change_backup_db_password
DB_BOOTSTRAP_USER=postgres
DB_BOOTSTRAP_PASSWORD=change_postgres_bootstrap_password

# Carpeta bin de PostgreSQL cuando sus herramientas no están en PATH.
# POSTGRES_BIN=C:\Program Files\PostgreSQL\18\bin

# Flask
SECRET_KEY=change_this_with_a_long_random_value
FLASK_DEBUG=1
SESSION_COOKIE_SECURE=0

# Mailjet SMTP para PIN y notificaciones.
# MAIL_USERNAME es la API Key y MAIL_PASSWORD es la Secret Key de Mailjet.
# MAIL_DEFAULT_SENDER debe ser un remitente o dominio validado en Mailjet.
MAIL_SERVER=in-v3.mailjet.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_DEBUG=0
MAIL_USERNAME=your_mailjet_api_key
MAIL_PASSWORD=your_mailjet_secret_key
MAIL_DEFAULT_SENDER=ventas@newrecords.example

# Cuentas iniciales de desarrollo
ADMIN_NAME=Administrador New Records
ADMIN_EMAIL=admin@newrecords.local
ADMIN_PASSWORD=change_admin_password
CLIENTE_DEMO_NAME=Cliente Demo
CLIENTE_DEMO_EMAIL=cliente@newrecords.local
CLIENTE_DEMO_PASSWORD=change_client_password
